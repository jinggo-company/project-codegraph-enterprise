{
  "name": "@codegraph/mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "MCP Server gateway for CodeGraph Enterprise",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:http": "MCP_HTTP_PORT=5000 tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:http": "MCP_HTTP_PORT=5000 node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codegraph/engine": "workspace:*",
    "@codegraph/types": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.6.0",
    "express": "^5.2.1",
    "fastify": "^4.28.0",
    "sql.js": "^1.14.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@codegraph/config": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/sql.js": "^1.4.11",
    "fastify": "^4.28.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
